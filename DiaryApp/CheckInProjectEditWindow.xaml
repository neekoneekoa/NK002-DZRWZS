<Window x:Class="DiaryApp.CheckInProjectEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑打卡项目"
        Height="400"
        Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 项目名称 -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="项目名称：" FontSize="14" Foreground="#636E72" VerticalAlignment="Center"/>
            <TextBox x:Name="NameTextBox" Grid.Column="1" Height="35" FontSize="14" Padding="8"
                     BorderBrush="#DFE6E9" BorderThickness="1" Background="#FAFAFA"/>
        </Grid>
        
        <!-- 项目类型 -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="项目类型：" FontSize="14" Foreground="#636E72" VerticalAlignment="Center"/>
            <TextBox x:Name="TypeTextBox" Grid.Column="1" Height="35" FontSize="14" Padding="8"
                     BorderBrush="#DFE6E9" BorderThickness="1" Background="#FAFAFA"/>
        </Grid>
        
        <!-- 标签 -->
        <Grid Grid.Row="2" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="标签：" FontSize="14" Foreground="#636E72" VerticalAlignment="Top" Margin="0,5,0,0"/>
            <StackPanel Grid.Column="1">
                <TextBox x:Name="TagsTextBox" Height="35" FontSize="14" Padding="8"
                         BorderBrush="#DFE6E9" BorderThickness="1" Background="#FAFAFA"
                         Tag="输入标签，多个标签用逗号分隔"/>
                <ItemsControl x:Name="TagsItemsControl" Margin="0,10,0,0" HorizontalAlignment="Left">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#6C5CE7" CornerRadius="10" Margin="0,0,6,4" Padding="8,2,8,2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding}" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                                    <Button Content="×" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="12" 
                                            Margin="6,0,0,0" Padding="0" VerticalAlignment="Center"
                                            Click="RemoveTagButton_Click" Tag="{Binding}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
        
        <!-- 操作按钮 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="取消" Width="100" Height="35" Margin="0,0,10,0"
                    Background="#F0F3F8" Foreground="#636E72" BorderThickness="0"
                    Click="CancelButton_Click" Cursor="Hand"/>
            <Button x:Name="SaveButton" Content="保存" Width="100" Height="35"
                    Background="#6C5CE7" Foreground="White" BorderThickness="0"
                    Click="SaveButton_Click" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>