<Window x:Class="DiaryApp.TaskEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DiaryApp"
        mc:Ignorable="d"
        Title="编辑任务" Height="850" Width="1100"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    
    <Window.Resources>
        <!-- 颜色定义 -->
        <Color x:Key="PrimaryColor">#FF6C5CE7</Color>
        <Color x:Key="SecondaryColor">#FFA29BFE</Color>
        <Color x:Key="AccentColor">#FFFF7675</Color>
        
        <!-- 日历日期按钮样式，用于高亮显示提醒日期 -->
        <Style x:Key="HighlightedCalendarDayButtonStyle" TargetType="CalendarDayButton">
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsToday}" Value="True">
                    <Setter Property="Background" Value="#FFF0F0F0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsSelected}" Value="True">
                    <Setter Property="Background" Value="#00CEC9"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsInactive}" Value="True">
                    <Setter Property="Foreground" Value="#CCCCCC"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Border CornerRadius="15" Background="#FDFDFD" Margin="10">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
        

            
    
            
            <!-- 任务标题和日历 -->
            <Grid Grid.Row="1" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBox x:Name="TitleTextBox" Width="300" FontSize="16" Padding="10" Tag="请输入任务标题"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <!-- 日历控件 -->
                    <Calendar x:Name="ReminderCalendar" Width="200" Height="200" Margin="0,0,20,0"
                              Background="White" BorderBrush="#E1E8ED" BorderThickness="1"
                              SelectionMode="SingleDate"
                              CalendarDayButtonStyle="{StaticResource HighlightedCalendarDayButtonStyle}"/>
                </StackPanel>
            </Grid>
            

            
            <!-- 任务类型、优先级、状态和完成时间 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,15" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="任务类型：" FontSize="14" Foreground="#636E72" Width="70"/>
                    <ComboBox x:Name="TaskTypeComboBox" SelectedIndex="0" Width="100" Height="30" SelectionChanged="TaskTypeComboBox_SelectionChanged">
                        <ComboBoxItem Content="临时任务"/>
                        <ComboBoxItem Content="项目"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="优先级：" FontSize="14" Foreground="#636E72" Width="60"/>
                    <ComboBox x:Name="PriorityComboBox" SelectedIndex="1" Width="80" Height="30">
                        <ComboBoxItem Content="高"/>
                        <ComboBoxItem Content="中"/>
                        <ComboBoxItem Content="低"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="状态：" FontSize="14" Foreground="#636E72" Width="50"/>
                    <ComboBox x:Name="StatusComboBox" SelectedIndex="0" Width="100" Height="30">
                        <ComboBoxItem Content="待完成"/>
                        <ComboBoxItem Content="进行中"/>
                        <ComboBoxItem Content="已完成"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="完成时间：" FontSize="14" Foreground="#636E72" Width="80"/>
                    <DatePicker x:Name="CompletedDatePicker" Width="120" Height="30"/>
                </StackPanel>
                <Button x:Name="AddChapterButton" Content="+ 添加章节" Width="100" Height="30"
                        Background="#6C5CE7" Foreground="White" BorderThickness="0"
                        Click="AddChapterButton_Click" FontSize="12" Margin="20,0,0,0"/>
            </StackPanel>
            
            <!-- 项目标签编辑框 -->
            <StackPanel x:Name="ProjectTagsPanel" Grid.Row="2" Margin="0,50,0,15" Orientation="Horizontal" Visibility="Collapsed">
                <TextBlock Text="项目标签：" FontSize="14" Foreground="#636E72" Width="70" VerticalAlignment="Center"/>
                <TextBox x:Name="ProjectTagsTextBox" Width="400" Height="30" FontSize="14" Padding="8" Tag="请输入项目标签，用逗号分隔"/>
                <Button x:Name="AddTagButton" Content="添加标签" Width="80" Height="30" Background="#6C5CE7" Foreground="White" BorderThickness="0" Margin="10,0,0,0" Click="AddTagButton_Click"/>
            </StackPanel>
            <StackPanel x:Name="ProjectTagsDisplayPanel" Grid.Row="2" Margin="75,80,0,15" Orientation="Horizontal" Visibility="Collapsed">
                <ItemsControl x:Name="ProjectTagsItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#E1E8ED" CornerRadius="15" Margin="0,0,5,0" Padding="8,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding}" FontSize="12" Foreground="#2D3436" VerticalAlignment="Center"/>
                                    <Button Content="×" Width="16" Height="16" Background="Transparent" BorderThickness="0" Foreground="#636E72" FontSize="10" Margin="5,0,0,0" Click="RemoveTagButton_Click" Tag="{Binding}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            
            <!-- 提醒设置区域 -->
            <StackPanel Grid.Row="2" Margin="0,110,0,15" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ReminderButton" Content="设置提醒" Width="100" Height="30"
                        Background="#00CEC9" Foreground="White" BorderThickness="0"
                        Click="ReminderButton_Click" FontSize="12" Margin="0,0,20,0"/>
                
                <StackPanel x:Name="ReminderInfoPanel" Orientation="Horizontal" Margin="0,0,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                        <TextBlock Text="开始日期：" FontSize="12" Foreground="#636E72" Width="80" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ReminderStartDateText" FontSize="12" Foreground="#2D3436" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                        <TextBlock Text="提醒类型：" FontSize="12" Foreground="#636E72" Width="80" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ReminderTypeText" FontSize="12" Foreground="#2D3436" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                        <TextBlock Text="下次提醒：" FontSize="12" Foreground="#636E72" Width="80" VerticalAlignment="Center"/>
                        <TextBlock x:Name="NextReminderDateText" FontSize="12" Foreground="#2D3436" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                        <TextBlock Text="提醒状态：" FontSize="12" Foreground="#636E72" Width="80" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ReminderStatusText" FontSize="12" Foreground="#2D3436" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            
            <!-- 章节和子任务 -->
            <Grid Grid.Row="3" Margin="0,0,0,15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- 章节标题 -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="章节：" FontSize="14" FontWeight="Bold" Foreground="#2D3436" Margin="0,0,10,10"/>
                
                <!-- 章节列表 -->
                <ScrollViewer Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" VerticalScrollBarVisibility="Auto" Margin="0,5,0,0">
                    <StackPanel x:Name="ChaptersPanel"/>
                </ScrollViewer>
            </Grid>

        <!-- 按钮 -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button x:Name="SaveButton" Content="保存" Width="80" Height="35" Background="#6C5CE7" Foreground="White" BorderThickness="0" Margin="0,0,10,0" Click="SaveButton_Click"/>
                <Button x:Name="DeleteButton" Content="删除" Width="80" Height="35" Background="#FF7675" Foreground="White" BorderThickness="0" Margin="0,0,10,0" Click="DeleteButton_Click"/>
                <Button x:Name="CancelButton" Content="取消" Width="80" Height="35" Background="#BDC3C7" Foreground="#2D3436" BorderThickness="0" Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>