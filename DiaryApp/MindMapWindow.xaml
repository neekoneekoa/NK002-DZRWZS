<Window x:Class="DiaryApp.MindMapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DiaryApp"
        mc:Ignorable="d"
        Title="个人数据管理" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FA">

    <Window.Resources>
        <!-- 节点样式 -->
        <Style x:Key="MindMapNodeStyle" TargetType="Border">
            <Setter Property="Background" Value="#6C5CE7"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="5" ShadowDepth="2" Opacity="0.3" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 根节点样式 -->
        <Style x:Key="RootNodeStyle" TargetType="Border" BasedOn="{StaticResource MindMapNodeStyle}">
            <Setter Property="Background" Value="#FF7675"/>
            <Setter Property="Padding" Value="20,12"/>
        </Style>

        <!-- 子节点样式 -->
        <Style x:Key="ChildNodeStyle" TargetType="Border" BasedOn="{StaticResource MindMapNodeStyle}">
            <Setter Property="Background" Value="#74B9FF"/>
        </Style>

        <!-- 按钮样式 -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0E0E0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0" Background="White" BorderBrush="#DFE6E9" BorderThickness="0,0,0,1" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 标题 -->
                <TextBlock Grid.Column="0" Text="📊 个人数据管理" FontSize="18" FontWeight="Bold" Foreground="#2D3436" VerticalAlignment="Center"/>

                <!-- 操作按钮 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="AddRootChildButton" Content="➕ 添加分支" Height="35" 
                            Background="#00B894" Foreground="White" BorderThickness="0"
                            FontSize="14" FontWeight="Bold" Margin="0,0,10,0"
                            Click="AddRootChildButton_Click"/>
                    <Button x:Name="SaveButton" Content="💾 保存" Height="35" 
                            Background="#6C5CE7" Foreground="White" BorderThickness="0"
                            FontSize="14" FontWeight="Bold" Margin="0,0,10,0"
                            Click="SaveButton_Click"/>
                    <Button Content="✕" Width="35" Height="35" Background="Transparent" 
                            BorderThickness="0" FontSize="18" Foreground="#636E72"
                            Click="CloseButton_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                <Setter Property="Width" Value="35"/>
                                <Setter Property="Height" Value="35"/>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 思维导图画布 -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Border Background="#FFFFFF" Margin="10">
                <Canvas x:Name="MindMapCanvas" Width="800" Height="600" Background="#FAFAFA">
                    <!-- 思维导图节点将通过代码动态添加到这里 -->
                </Canvas>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
