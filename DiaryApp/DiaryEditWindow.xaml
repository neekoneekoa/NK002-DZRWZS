<Window x:Class="DiaryApp.DiaryEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="日记查看" Height="700" Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Background="#F8F9FA" Margin="15" KeyDown="Window_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,10">
            <TextBlock Text="📝 日记" FontSize="20" FontWeight="Bold" Foreground="#2D3436"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <TextBox x:Name="DiaryTitleTextBox" 
                         Text="输入日记标题..." FontSize="20" FontWeight="Bold" Foreground="#2D3436"
                         Background="Transparent" BorderThickness="0"
                         TextWrapping="Wrap" Margin="0,0,0,8"
                         GotFocus="DiaryTitleTextBox_GotFocus" LostFocus="DiaryTitleTextBox_LostFocus"/>
                
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,5,0,0">
                    <TextBlock Text="📅" FontSize="14" Foreground="#636E72" Margin="0,0,5,0"/>
                    <DatePicker x:Name="DatePicker" Background="Transparent" BorderThickness="0" 
                                Width="120" VerticalContentAlignment="Center"/>
                    <TextBlock Text="📖" FontSize="14" Foreground="#636E72" Margin="15,0,5,0"/>
                    <ComboBox x:Name="PeriodTypeComboBox" Width="80" SelectedIndex="0" 
                              Background="Transparent" BorderThickness="1" BorderBrush="#DFE6E9">
                        <ComboBoxItem Content="日常"/>
                        <ComboBoxItem Content="周记"/>
                        <ComboBoxItem Content="月计"/>
                        <ComboBoxItem Content="季记"/>
                        <ComboBoxItem Content="年记"/>
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="🏷️ 标签" FontSize="12" Foreground="#636E72" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TagInputTextBox" 
                             Text="输入标签后按回车添加" FontSize="13" Foreground="#B2BEC3"
                             Background="#F8F9FA" BorderThickness="1" BorderBrush="#DFE6E9"
                             GotFocus="TagInputTextBox_GotFocus" LostFocus="TagInputTextBox_LostFocus"
                             KeyDown="TagInputTextBox_KeyDown"/>
                    <Button Grid.Column="1" Content="➕" Width="30" Height="25" Margin="5,0,0,0"
                            Background="#A29BFE" Foreground="White" BorderThickness="0"
                            Click="AddTagButton_Click"/>
                </Grid>
                <WrapPanel x:Name="TagsPanel" Orientation="Horizontal" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Border Grid.Row="0" Background="#F8F9FA" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Text="字体颜色:" FontSize="12" Foreground="#636E72" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <Button Width="24" Height="24" Margin="2,0" Background="#FF0000" BorderThickness="1" BorderBrush="#DFE6E9" Click="ColorButton_Click"/>
                        <Button Width="24" Height="24" Margin="2,0" Background="#00FF00" BorderThickness="1" BorderBrush="#DFE6E9" Click="ColorButton_Click"/>
                        <Button Width="24" Height="24" Margin="2,0" Background="#0000FF" BorderThickness="1" BorderBrush="#DFE6E9" Click="ColorButton_Click"/>
                        <Button Width="24" Height="24" Margin="2,0" Background="#FFFF00" BorderThickness="1" BorderBrush="#DFE6E9" Click="ColorButton_Click"/>
                        <Button Width="24" Height="24" Margin="2,0" Background="#FF00FF" BorderThickness="1" BorderBrush="#DFE6E9" Click="ColorButton_Click"/>
                        <Button Width="24" Height="24" Margin="2,0" Background="#00FFFF" BorderThickness="1" BorderBrush="#DFE6E9" Click="ColorButton_Click"/>
                        <Button Width="24" Height="24" Margin="2,0" Background="#000000" BorderThickness="1" BorderBrush="#DFE6E9" Click="ColorButton_Click"/>
                        <Button Width="24" Height="24" Margin="2,0" Background="#FFFFFF" BorderThickness="1" BorderBrush="#DFE6E9" Click="ColorButton_Click"/>
                        <Border Width="1" Height="20" Background="#DFE6E9" Margin="10,0"/>
                        <TextBlock Text="字体大小:" FontSize="12" Foreground="#636E72" Margin="5,0" VerticalAlignment="Center"/>
                        <ComboBox x:Name="FontSizeComboBox" Width="60" Height="24" SelectedIndex="2" SelectionChanged="FontSizeComboBox_SelectionChanged">
                            <ComboBoxItem Content="12"/>
                            <ComboBoxItem Content="14"/>
                            <ComboBoxItem Content="16"/>
                            <ComboBoxItem Content="18"/>
                            <ComboBoxItem Content="20"/>
                            <ComboBoxItem Content="24"/>
                            <ComboBoxItem Content="28"/>
                            <ComboBoxItem Content="32"/>
                        </ComboBox>
                        <Border Width="1" Height="20" Background="#DFE6E9" Margin="10,0"/>
                        <TextBlock Text="背景色:" FontSize="12" Foreground="#636E72" Margin="5,0" VerticalAlignment="Center"/>
                        <Button Width="24" Height="24" Margin="2,0" Background="#FFFF00" BorderThickness="1" BorderBrush="#DFE6E9" Click="BackgroundColorButton_Click" Tag="Yellow"/>
                        <Button Width="24" Height="24" Margin="2,0" Background="#00FF00" BorderThickness="1" BorderBrush="#DFE6E9" Click="BackgroundColorButton_Click" Tag="Lime"/>
                        <Button Width="24" Height="24" Margin="2,0" Background="#E0FFFF" BorderThickness="1" BorderBrush="#DFE6E9" Click="BackgroundColorButton_Click" Tag="LightCyan"/>
                        <Button Width="24" Height="24" Margin="2,0" Background="#FFE4E1" BorderThickness="1" BorderBrush="#DFE6E9" Click="BackgroundColorButton_Click" Tag="MistyRose"/>
                        <Button Width="24" Height="24" Margin="2,0" Background="#FFFFFF" BorderThickness="1" BorderBrush="#DFE6E9" Click="BackgroundColorButton_Click" Tag="White"/>
                        <Border Width="1" Height="20" Background="#DFE6E9" Margin="10,0"/>
                        <ToggleButton x:Name="UnderlineToggleButton" Content="U" FontSize="14" FontWeight="Bold" Width="28" Height="24" 
                                      Margin="5,0" Checked="UnderlineToggleButton_Checked" Unchecked="UnderlineToggleButton_Unchecked"/>
                        <Button Content="清空格式" FontSize="11" Width="70" Height="24" Margin="10,0" 
                                Background="#DFE6E9" BorderThickness="0" Click="ClearFormatButton_Click"/>
                    </WrapPanel>
                </Border>
                
                <RichTextBox Grid.Row="1" x:Name="DiaryContentRichTextBox" 
                             Background="Transparent" BorderThickness="0"
                             AcceptsReturn="True" AcceptsTab="True"
                             VerticalScrollBarVisibility="Auto"
                             IsDocumentEnabled="True">
                    <RichTextBox.Resources>
                        <Style TargetType="Paragraph">
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                        </Style>
                    </RichTextBox.Resources>
                </RichTextBox>
            </Grid>
        </Border>

        <Border Grid.Row="4" Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="📷 照片" FontSize="12" Foreground="#636E72" Margin="0,0,0,5"/>
                <Button Content="➕ 添加照片" Width="100" Height="30" 
                        Background="#A29BFE" Foreground="White" BorderThickness="0"
                        Click="AddPhotoButton_Click" HorizontalAlignment="Left"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" 
                              Margin="0,8,0,0" Height="100">
                    <WrapPanel x:Name="DiaryPhotosPanel" Orientation="Horizontal"/>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="关闭" Width="80" Height="35" Background="#DFE6E9" Foreground="#2D3436" 
                    BorderThickness="0" Margin="0,0,10,0" Click="CancelButton_Click"/>
            <Button Content="💾 保存 (Ctrl+S)" Width="130" Height="35" Background="#00B894" Foreground="White" 
                    BorderThickness="0" FontWeight="Bold" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
