<Window x:Class="DiaryApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DiaryApp"
        mc:Ignorable="d"
        Title="My Diary" Height="600" Width="900"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- 棰滆壊瀹氫箟 -->
        <Color x:Key="PrimaryColor">#FF6C5CE7</Color> <!-- 杞传鑹?-->
        <Color x:Key="SecondaryColor">#FFA29BFE</Color>
        <Color x:Key="AccentColor">#FFFF7675</Color> <!-- 杞孩鑹?-->
        
        <!-- 鏍峰紡锛氬渾褰㈡寜閽?-->
        <Style x:Key="RoundButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="bg" Fill="#FFA29BFE" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="White" TextElement.FontWeight="Bold"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Fill" Value="#FF6C5CE7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Fill" Value="#FF4834D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 鏍峰紡锛氬垪琛ㄩ」 -->
        <Style x:Key="DiaryItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Margin="0,0,0,8" Padding="10" BorderThickness="2" BorderBrush="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4D6C5CE7"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF6C5CE7"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A6C5CE7"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#806C5CE7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 杞崲鍣?-->
        <local:PriorityToColorConverter x:Key="PriorityToColorConverter"/>
        <local:LevelToMarginConverter x:Key="LevelToMarginConverter"/>
        <local:LevelToFontWeightConverter x:Key="LevelToFontWeightConverter"/>
        <local:LevelToFontSizeConverter x:Key="LevelToFontSizeConverter"/>
        <local:BooleanToUnderlineConverter x:Key="BooleanToUnderlineConverter"/>
        
        <!-- 绐楀彛鎺у埗鎸夐挳鏍峰紡 -->
        <Style x:Key="WindowControlButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0E0E0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowBorder" CornerRadius="20" Background="#FDFDFD" Margin="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.3" Color="#6C5CE7"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 绐楀彛鎺у埗鎸夐挳鍖哄煙 -->
                <RowDefinition Height="*"/>    <!-- 涓诲唴瀹瑰尯鍩?-->
            </Grid.RowDefinitions>
            
            <!-- 椤堕儴璋冩暣鍖哄煙锛堢敤浜庤皟鏁寸獥鍙ｅぇ灏忓拰鎷栧姩绐楀彛锛?-->
            <Border Grid.Row="0" Height="5" VerticalAlignment="Top" Background="Transparent" x:Name="TopResizeBorder"/>
            
            <!-- 宸︿晶璋冩暣鍖哄煙 -->
            <Border Grid.Row="1" Width="5" HorizontalAlignment="Left" Background="Transparent" x:Name="LeftResizeBorder"/>
            
            <!-- 鍙充晶璋冩暣鍖哄煙 -->
            <Border Grid.Row="1" Width="5" HorizontalAlignment="Right" Background="Transparent" x:Name="RightResizeBorder"/>
            
            <!-- 搴曢儴璋冩暣鍖哄煙 -->
            <Border Grid.Row="2" Height="5" VerticalAlignment="Bottom" Background="Transparent" x:Name="BottomResizeBorder"/>
            
            <!-- 鍙充笅瑙掕皟鏁存墜鏌?-->
            <ResizeGrip x:Name="ResizeGrip" Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                       Width="15" Height="15" Foreground="#6C5CE7"/>
            
            <!-- 绐楀彛鎺у埗鎸夐挳鍜屾棩鏈熸樉绀?-->
            <Grid Grid.Row="0" Margin="15,15,15,0">
                <TextBlock x:Name="DateLabel" Text="" FontSize="14" Foreground="#636E72" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="S" Style="{StaticResource WindowControlButtonStyle}" Click="SettingsButton_Click" Foreground="#0984E3" FontSize="14" ToolTip="设置"/>
                    <Button Content="T" Style="{StaticResource WindowControlButtonStyle}" Click="BackgroundButton_Click" Foreground="#20B2AA" FontSize="14" ToolTip="后台运行"/>
                    <Button Content="-" Style="{StaticResource WindowControlButtonStyle}" Click="MinimizeButton_Click" Foreground="#2D3436" FontSize="18" ToolTip="最小化"/>
                    <Button Content="[]" Style="{StaticResource WindowControlButtonStyle}" Click="MaximizeButton_Click" Foreground="#2D3436" FontSize="14" ToolTip="全屏"/>
                    <Button Content="X" Style="{StaticResource WindowControlButtonStyle}" Click="CloseButton_Click" Foreground="#D63031" FontSize="16" ToolTip="关闭"/>
                </StackPanel>
            </Grid>

            <!-- 涓诲唴瀹瑰尯鍩?-->
            <Grid Grid.Row="1" Margin="20,0,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 妯″潡鏍囬鏍?-->
                    <RowDefinition Height="*"/>    <!-- 鍐呭鍖哄煙 -->
                </Grid.RowDefinitions>

                <!-- 妯″潡鏍囩椤?-->
                <TabControl x:Name="MainTabControl" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectionChanged="MainTabControl_SelectionChanged">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#636E72"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Grid>
                                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="20,8" Margin="0,0,8,0">
                                                <ContentPresenter x:Name="contentSite"
                                                                VerticalAlignment="Center"
                                                                HorizontalAlignment="Center"
                                                                ContentSource="Header"
                                                                Margin="10,5"/>
                                            </Border>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#6C5CE7"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#A29BFE"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="False">
                                                <Setter Property="Foreground" Value="#636E72"/>
                                            </Trigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsSelected" Value="True"/>
                                                    <Condition Property="IsMouseOver" Value="True"/>
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="border" Property="Background" Value="#6C5CE7"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </MultiTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>

                    <!-- 鏃ヨ妯″潡 -->
                    <TabItem Header="日记">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280" MinWidth="150"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*" MinWidth="200"/>
                            </Grid.ColumnDefinitions>

                            <!-- 宸︿晶鍔熻兘鍖?-->
                            <Border Grid.Column="0" CornerRadius="15" Background="#F0F3F8" Margin="0,0,10,0">
                                <Grid Margin="15">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- 鏍囬 -->
                                    <TextBlock Grid.Row="0" Text="日记" FontSize="18" FontWeight="Bold" 
                                               Foreground="#2D3436" Margin="0,0,0,15"/>

                                    <!-- 鎼滅储妗嗭紙甯︽彁绀猴級 -->
                                    <Border Grid.Row="1" Background="White" CornerRadius="8" Margin="0,0,0,10">
                                        <Grid>
                                            <TextBlock x:Name="DiarySearchPlaceholder" Text="搜索日记..." 
                                                       FontSize="12" Foreground="#B2BEC3" 
                                                       VerticalAlignment="Center" Margin="10,0" IsHitTestVisible="False"/>
                                            <TextBox x:Name="DiarySearchBox" BorderThickness="0" 
                                                     Background="Transparent" Padding="10,8"
                                                     TextChanged="DiarySearchBox_TextChanged" 
                                                     GotFocus="DiarySearchBox_GotFocus" LostFocus="DiarySearchBox_LostFocus"/>
                                        </Grid>
                                    </Border>

                                    <!-- 鏍囩绛涢€?-->
                                    <Border Grid.Row="2" Background="White" CornerRadius="8" Margin="0,0,0,10">
                                        <Grid>
                                            <TextBlock x:Name="DiaryTagPlaceholder" Text="按标签筛选..." 
                                                       FontSize="12" Foreground="#B2BEC3" 
                                                       VerticalAlignment="Center" Margin="10,0" IsHitTestVisible="False"/>
                                            <TextBox x:Name="DiaryTagFilterBox" BorderThickness="0" 
                                                     Background="Transparent" Padding="10,8"
                                                     TextChanged="DiaryTagFilterBox_TextChanged"
                                                     GotFocus="DiaryTagFilterBox_GotFocus" LostFocus="DiaryTagFilterBox_LostFocus"
                                                     PreviewMouseLeftButtonUp="DiaryTagFilterBox_PreviewMouseLeftButtonUp"/>
                                            <Popup x:Name="DiaryTagPopup" PlacementTarget="{Binding ElementName=DiaryTagFilterBox}" StaysOpen="False" PopupAnimation="Slide">
                                                <Border Background="White" BorderBrush="#DFE6E9" BorderThickness="1" CornerRadius="4" Padding="8" MinWidth="200" MaxWidth="400">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="#EEEEEE" Opacity="0.5"/>
                                                    </Border.Effect>
                                                    <StackPanel>
                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="快捷标签" FontSize="12" FontWeight="Bold" Foreground="#636E72" VerticalAlignment="Center"/>
                                                            <Button Grid.Column="1" Content="X" Width="20" Height="20" Background="Transparent" BorderThickness="0" Foreground="#636E72" 
                                                                    Click="ClosePopup_Click" Cursor="Hand" ToolTip="关闭"/>
                                                        </Grid>
                                                        <ItemsControl x:Name="DiaryQuickTagsItemsControl">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel Orientation="Horizontal"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Background="{Binding Converter={StaticResource TagToColorConverter}}" CornerRadius="12" Margin="0,0,6,6" Padding="10,4" Cursor="Hand" MouseLeftButtonDown="DiaryQuickTag_Click">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="{Binding}" Foreground="White" FontSize="12" Margin="0,0,6,0"/>
                                                                            <Button Content="x" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="14" 
                                                                                    Click="DeleteDiaryQuickTagButton_Click" Tag="{Binding}" Focusable="False"
                                                                                    Padding="2,-2,2,0" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                                    ToolTip="删除此快捷标签"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBlock x:Name="NoDiaryQuickTagsText" Text="暂无常用标签" FontSize="12" Foreground="#B2BEC3" HorizontalAlignment="Center" Margin="5" Visibility="Collapsed"/>
                                                    </StackPanel>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                    </Border>

                                    <!-- 鍛ㄦ湡绫诲瀷绛涢€?-->
                                    <Border Grid.Row="3" Background="White" CornerRadius="8" Margin="0,0,0,10">
                                        <Grid>
                                            <TextBlock x:Name="DiaryPeriodPlaceholder" Text="按周期筛选..." 
                                                       FontSize="12" Foreground="#B2BEC3" 
                                                       VerticalAlignment="Center" Margin="10,0" IsHitTestVisible="False"/>
                                            <ComboBox x:Name="DiaryPeriodFilterBox" BorderThickness="0" 
                                                      Background="Transparent" Padding="10,8"
                                                      SelectionChanged="DiaryPeriodFilterBox_SelectionChanged">
                                                <ComboBoxItem Content="全部"/>
                                                <ComboBoxItem Content="日常"/>
                                                <ComboBoxItem Content="周记"/>
                                                <ComboBoxItem Content="月记"/>
                                                <ComboBoxItem Content="季记"/>
                                                <ComboBoxItem Content="年记"/>
                                            </ComboBox>
                                        </Grid>
                                    </Border>

                                    <!-- 娣诲姞鎸夐挳 -->
                                    <Button Grid.Row="4" Content="+ 新建日记" Height="40" Background="#A29BFE" 
                                            Foreground="White" BorderThickness="0" FontWeight="Bold"
                                            Margin="0,0,0,10" Click="NewDiaryButton_Click"/>

                                    <!-- 涓€涓湀蹇€熸棩鏈熷畾浣?-->
                                    <Border Grid.Row="5" Background="White" CornerRadius="8" Padding="12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            
                                            <!-- 鏈堜唤瀵艰埅 -->
                                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <Button Grid.Column="0" Content="&lt;" Width="25" Height="25" 
                                                        Background="Transparent" BorderThickness="1" BorderBrush="#DFE6E9"
                                                        Click="PreviousMonthButton_Click" FontSize="12"/>
                                                
                                                <TextBlock Grid.Column="1" x:Name="CurrentMonthText" Text="2024年1月" 
                                                           FontSize="14" FontWeight="Bold" Foreground="#2D3436" 
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                
                                                <Button Grid.Column="2" Content=">" Width="25" Height="25" 
                                                        Background="Transparent" BorderThickness="1" BorderBrush="#DFE6E9"
                                                        Click="NextMonthButton_Click" FontSize="12"/>
                                            </Grid>
                                            
                                            <!-- 星期标题 -->
                                            <UniformGrid Grid.Row="1" Columns="7" Margin="0,0,0,8">
                                                <TextBlock Text="日" HorizontalAlignment="Center" FontSize="11" Foreground="#636E72" FontWeight="Bold"/>
                                                <TextBlock Text="一" HorizontalAlignment="Center" FontSize="11" Foreground="#636E72" FontWeight="Bold"/>
                                                <TextBlock Text="二" HorizontalAlignment="Center" FontSize="11" Foreground="#636E72" FontWeight="Bold"/>
                                                <TextBlock Text="三" HorizontalAlignment="Center" FontSize="11" Foreground="#636E72" FontWeight="Bold"/>
                                                <TextBlock Text="四" HorizontalAlignment="Center" FontSize="11" Foreground="#636E72" FontWeight="Bold"/>
                                                <TextBlock Text="五" HorizontalAlignment="Center" FontSize="11" Foreground="#636E72" FontWeight="Bold"/>
                                                <TextBlock Text="六" HorizontalAlignment="Center" FontSize="11" Foreground="#636E72" FontWeight="Bold"/>
                                            </UniformGrid>
                                            
                                            <!-- 鏃ュ巻缃戞牸 -->
                                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="250">
                                                <UniformGrid x:Name="DiaryMonthCalendarPanel" Columns="7"/>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- 鍙皟鏁村搴︾殑鍒嗛殧鏉?-->
                            <GridSplitter Grid.Column="1" Width="6" Background="#DFE6E9" 
                                         HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                         ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                                         Cursor="SizeWE" Margin="0"/>

                            <!-- 鍙充晶鏃堕棿杞存棩璁扮洰褰?-->
                            <Border Grid.Column="2" CornerRadius="15" Background="#FFFFFF" Padding="15">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="DiaryTimelinePanel"/>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- 浠诲姟妯″潡 -->
                    <TabItem Header="任务">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" MinWidth="100"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="250" MinWidth="150"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*" MinWidth="200"/>
                            </Grid.ColumnDefinitions>

                            <!-- 宸︿晶鍔熻兘鍖?-->
                            <Border Grid.Column="0" CornerRadius="15" Background="#F0F3F8" Margin="0,0,10,0">
                                <StackPanel Margin="15" Orientation="Vertical">
                                    <!-- 鍔熻兘鍖烘爣棰?-->
                                    <TextBlock Text="功能区" FontSize="16" FontWeight="Bold" Foreground="#2D3436" Margin="0,0,0,15"/>
                                    
                                    <!-- 娣诲姞浠诲姟鎸夐挳 -->
                                    <Button Content="+ 添加任务" Height="40" Background="#A29BFE" 
                                            Foreground="White" BorderThickness="0" FontWeight="Bold"
                                            Margin="0,0,0,10" Click="NewTaskButton_Click"/>
                                    
                                    <!-- 鍒犻櫎浠诲姟鎸夐挳 -->
                                    <Button Content="- 删除任务" Height="40" Background="#FF7675" 
                                            Foreground="White" BorderThickness="0" FontWeight="Bold"
                                            Margin="0,0,0,15" Click="DeleteTaskButton_Click"/>
                                    
                                    <!-- 缂栬緫浠诲姟鎸夐挳 -->
                                    <Button Content="编辑任务" Height="40" Background="#6C5CE7" 
                                            Foreground="White" BorderThickness="0" FontWeight="Bold"
                                            Margin="0,0,0,10" Click="EditTaskButton_Click"/>
                                    
                                    <!-- 鍔熻兘鍖哄叾浠栦俊鎭?-->
                                    <TextBlock Text="任务管理" FontSize="12" Foreground="#636E72" Margin="0,10,0,0"/>
                                    <TextBlock Text="• 添加新任务" FontSize="12" Foreground="#636E72" Margin="10,5,0,0"/>
                                    <TextBlock Text="• 删除选中任务" FontSize="12" Foreground="#636E72" Margin="10,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- 鍙皟鏁村搴︾殑鍒嗛殧鏉?-->
                            <GridSplitter Grid.Column="1" Width="6" Background="#DFE6E9" 
                                         HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                         ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                                         Cursor="SizeWE" Margin="0"/>

                            <!-- 涓棿涓存椂浠诲姟鍖?-->
                            <Border Grid.Column="2" CornerRadius="15" Background="#F0F8FF" Margin="0,0,10,0">
                                <Grid Margin="15">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- 涓存椂浠诲姟鍖烘爣棰?-->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="临时任务" FontSize="16" FontWeight="Bold" Foreground="#2D3436" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding TempTaskCount, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" FontSize="14" Foreground="#636E72" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- 涓存椂浠诲姟鍒楄〃 -->
                                    <ListBox Grid.Row="1" x:Name="TempTaskListBox" 
                                             Background="Transparent" BorderThickness="0" 
                                             SelectionMode="Single"
                                             SelectionChanged="TempTaskListBox_SelectionChanged">
                                        <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,5">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}" 
                                                               FontSize="14" 
                                                               Foreground="Black">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    
                                                    <!-- 浠诲姟鏍囩鏄剧ず -->
                                                    <ItemsControl ItemsSource="{Binding ProjectTags}" Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{Binding Converter={StaticResource TagToColorConverter}}" 
                                                                        CornerRadius="4" Margin="0,0,4,0" Padding="6,2">
                                                                    <TextBlock Text="{Binding}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                            
                            <!-- 绗簩涓彲璋冩暣瀹藉害鐨勫垎闅旀潯 -->
                            <GridSplitter Grid.Column="3" Width="6" Background="#DFE6E9" 
                                         HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                         ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                                         Cursor="SizeWE" Margin="0"/>
                            
                            <!-- 鍙充晶椤圭洰浠诲姟鍖?-->
                            <Border Grid.Column="4" CornerRadius="15" Background="#F1F8E9" Padding="15">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- 椤圭洰浠诲姟鍖烘爣棰?-->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
