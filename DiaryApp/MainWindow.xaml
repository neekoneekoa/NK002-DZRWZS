                                                    <UniformGrid x:Name="ProjectCheckInCalendarGrid" Columns="7" Background="Transparent">
                                                        <!-- 鏃ュ巻灏嗛€氳繃浠ｇ爜鍔ㄦ€佺敓鎴?-->
                                                    </UniformGrid>
                                                </StackPanel>

                                                <!-- 蹇€熸墦鍗℃寜閽?-->
                                                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Content="查看日志" Width="120" Height="40" 
                                                            Background="#74B9FF" Foreground="White" BorderThickness="0"
                                                            FontWeight="Bold" Click="ViewCheckInLogButton_Click"
                                                            Margin="0,0,10,0"/>
                                                    <Button Content="编辑项目" Width="120" Height="40" 
                                                            Background="#A29BFE" Foreground="White" BorderThickness="0"
                                                            FontWeight="Bold" Click="EditCheckInProjectButton_Click"
                                                            Margin="0,0,10,0"/>
                                                    <Button Content="删除项目" Width="120" Height="40"
                                                            Background="#FF7675" Foreground="White" BorderThickness="0"
                                                            FontWeight="Bold" Click="DeleteCheckInProjectButton_Click"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- 涓汉淇℃伅妯″潡 -->
                    <TabItem Header="个人">
                        <Border CornerRadius="15" Background="#FFFFFF" Padding="30">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 鏍囬 -->
                                <TextBlock Grid.Row="0" Text="个人信息" FontSize="24" FontWeight="Bold" 
                                           Foreground="#2D3436" Margin="0,0,0,30"/>

                                <!-- 璇存槑鏂囧瓧 -->
                                <TextBlock Grid.Row="1" Text="管理应用中的个人资料与公开示例信息" 
                                           FontSize="14" Foreground="#636E72" Margin="0,0,0,20"/>

                                <!-- 濮撳悕 -->
                                <Border Grid.Row="2" Background="#F0F3F8" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="姓名：" FontSize="14" FontWeight="Bold" 
                                                   Foreground="#2D3436" Margin="0,0,10,0"/>
                                        <TextBox x:Name="PersonalNameTextBox" Grid.Column="1" BorderThickness="0" 
                                                 Background="Transparent" FontSize="14" Padding="5,2"
                                                 TextChanged="PersonalNameTextBox_TextChanged" IsEnabled="False"/>
                                    </Grid>
                                </Border>

                                <!-- 鐢佃瘽 -->
                                <Border Grid.Row="3" Background="#F0F3F8" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="电话：" FontSize="14" FontWeight="Bold" 
                                                   Foreground="#2D3436" Margin="0,0,10,0"/>
                                        <TextBox x:Name="PersonalPhoneTextBox" Grid.Column="1" BorderThickness="0" 
                                                 Background="Transparent" FontSize="14" Padding="5,2"
                                                 TextChanged="PersonalPhoneTextBox_TextChanged" IsEnabled="False"/>
                                    </Grid>
                                </Border>

                                <!-- 鐢熸棩 -->
                                <Border Grid.Row="4" Background="#F0F3F8" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="生日：" FontSize="14" FontWeight="Bold" 
                                                   Foreground="#2D3436" Margin="0,0,10,0"/>
                                        <DatePicker x:Name="PersonalBirthdayPicker" Grid.Column="1" BorderThickness="0" 
                                                    Background="Transparent" FontSize="14"
                                                    SelectedDateChanged="PersonalBirthdayPicker_SelectedDateChanged" IsEnabled="False"/>
                                    </Grid>
                                </Border>

                                <!-- 瀛樻 -->
                                <Border Grid.Row="5" Background="#F0F3F8" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="存款：" FontSize="14" FontWeight="Bold" 
                                                   Foreground="#2D3436" Margin="0,0,10,0"/>
                                        <TextBox x:Name="PersonalSavingsTextBox" Grid.Column="1" BorderThickness="0" 
                                                 Background="Transparent" FontSize="14" Padding="5,2"
                                                 TextChanged="PersonalSavingsTextBox_TextChanged" IsEnabled="False"/>
                                    </Grid>
                                </Border>

                                <!-- 淇敼/淇濆瓨鎸夐挳 -->
                                <TextBlock x:Name="PersonalLastUpdatedText" Grid.Row="7"
                                           Text="最后更新：" FontSize="12" Foreground="#636E72"
                                           HorizontalAlignment="Center" Margin="0,20,0,12"/>

                                <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0" Panel.ZIndex="10">
                                    <Button x:Name="EditPersonalInfoButton" Content="编辑个人信息" Width="140" Height="45" 
                                            Background="#FFB74D" Foreground="White" BorderThickness="0"
                                            FontSize="16" FontWeight="Bold" Margin="0,0,10,0"
                                            Click="EditPersonalInfoButton_Click"/>
                                    <Button x:Name="SavePersonalInfoButton" Content="保存个人信息" Width="140" Height="45" 
                                            Background="#00B894" Foreground="White" BorderThickness="0"
                                            FontSize="16" FontWeight="Bold" Margin="0,0,10,0"
                                            Click="SavePersonalInfoButton_Click"/>
                                    <Button x:Name="MindMapButton" Content="查看思维导图" Width="140" Height="45" 
                                            Background="#6C5CE7" Foreground="White" BorderThickness="0"
                                            FontSize="16" FontWeight="Bold"
                                            Click="MindMapButton_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </TabItem>

                    <!-- 鏁版嵁绠＄悊妯″潡 -->
                    <TabItem Header="数据管理">
                        <Border CornerRadius="15" Background="#FFFFFF" Padding="30">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 鏍囬 -->
                                <TextBlock Grid.Row="0" Text="数据管理" FontSize="24" FontWeight="Bold" Foreground="#2D3436" Margin="0,0,0,30"/>

                                <!-- 璇存槑鏂囧瓧 -->
                                <TextBlock Grid.Row="1" Text="管理应用数据，包括保存、导出、导入和备份" 
                                           FontSize="14" Foreground="#636E72" Margin="0,0,0,20"/>

                                <!-- 缁熻鏁版嵁鍖哄煙 -->
                                <StackPanel Grid.Row="2" Margin="0,0,0,30">
                                    <!-- 绗竴閮ㄥ垎锛氬熀纭€缁熻 -->
                                    <UniformGrid Columns="4" Margin="0,0,0,20">
                                        <!-- 鍏ㄩ儴鎵撳崱鏁?-->
                                        <Border Background="#F0F3F8" CornerRadius="8" Padding="15" Margin="0,0,10,0">
                                            <StackPanel>
                                                <TextBlock Text="全部打卡数" FontSize="12" Foreground="#636E72" Margin="0,0,0,5"/>
                                                <TextBlock x:Name="StatsTotalCheckInsText" Text="0" FontSize="24" FontWeight="Bold" Foreground="#6C5CE7"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- 璁板綍澶╂暟 -->
                                        <Border Background="#F0F3F8" CornerRadius="8" Padding="15" Margin="5,0,5,0">
                                            <StackPanel>
                                                <TextBlock Text="记录天数" FontSize="12" Foreground="#636E72" Margin="0,0,0,5"/>
                                                <TextBlock x:Name="StatsRecordedDaysText" Text="0" FontSize="24" FontWeight="Bold" Foreground="#0984E3"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- 鍏ㄩ儴浠诲姟鏁?-->
                                        <Border Background="#F0F3F8" CornerRadius="8" Padding="15" Margin="5,0,5,0">
                                            <StackPanel>
                                                <TextBlock Text="全部任务数" FontSize="12" Foreground="#636E72" Margin="0,0,0,5"/>
                                                <TextBlock x:Name="StatsTotalTasksText" Text="0" FontSize="24" FontWeight="Bold" Foreground="#00B894"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- 鏃ヨ鏁?-->
                                        <Border Background="#F0F3F8" CornerRadius="8" Padding="15" Margin="10,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="日记数" FontSize="12" Foreground="#636E72" Margin="0,0,0,5"/>
                                                <TextBlock x:Name="StatsTotalDiariesText" Text="0" FontSize="24" FontWeight="Bold" Foreground="#FF7675"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <!-- 绗簩閮ㄥ垎锛氳缁嗙粺璁?-->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- 鏈€闀胯繛缁墦鍗￠」鐩?-->
                                        <Border Grid.Row="0" Grid.Column="0" Background="#FFF5F5" CornerRadius="8" Padding="15" Margin="0,0,10,10">
                                            <StackPanel>
                                                <TextBlock Text="最长连续打卡" FontSize="14" FontWeight="Bold" Foreground="#2D3436" Margin="0,0,0,10"/>
                                                <TextBlock x:Name="StatsLongestStreakText" Text="暂无数据" FontSize="13" Foreground="#636E72" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- 杩炵画鏃ヨ -->
                                        <Border Grid.Row="0" Grid.Column="1" Background="#F0FFF4" CornerRadius="8" Padding="15" Margin="10,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="连续日记" FontSize="14" FontWeight="Bold" Foreground="#2D3436" Margin="0,0,0,10"/>
                                                <TextBlock x:Name="StatsDiaryStreakText" Text="0 天" FontSize="13" Foreground="#636E72"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- 鏈€杩戝畬鎴愰」鐩?-->
                                        <Border Grid.Row="1" Grid.Column="0" Background="#F0F8FF" CornerRadius="8" Padding="15" Margin="0,10,10,0">
                                            <StackPanel>
                                                <TextBlock Text="最近完成项目" FontSize="14" FontWeight="Bold" Foreground="#2D3436" Margin="0,0,0,10"/>
                                                <ItemsControl x:Name="StatsRecentProjectsList">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}" FontSize="13" Foreground="#636E72" Margin="0,0,0,5" TextTrimming="CharacterEllipsis"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <!-- 娲诲姩鏃堕暱Top3 -->
                                        <Border Grid.Row="1" Grid.Column="1" Background="#FFF9E6" CornerRadius="8" Padding="15" Margin="10,10,0,0">
                                            <StackPanel>
                                                <TextBlock Text="最长活动时间" FontSize="14" FontWeight="Bold" Foreground="#2D3436" Margin="0,0,0,10"/>
                                                <ItemsControl x:Name="StatsTopActivitiesList">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,5">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Name}" FontSize="13" Foreground="#636E72" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Time}" FontSize="13" Foreground="#636E72" Margin="10,0,0,0"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>

                                <!-- 鍔熻兘鎸夐挳鍖哄煙 -->
                                <Grid Grid.Row="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 宸︿晶鎸夐挳 -->
                                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                        <Button Content="保存当前数据" Height="60" Margin="0,0,0,15" 
                                                Background="#00B894" Foreground="White" BorderThickness="0"
                                                Click="SaveDataButton_Click" FontSize="16" FontWeight="Bold"/>
                                        <Button Content="导出兼容备份" Height="60" 
                                                Background="#0984E3" Foreground="White" BorderThickness="0"
                                                Click="ExportBackupButton_Click" FontSize="16" FontWeight="Bold"/>
                                    </StackPanel>

                                    <!-- 鍙充晶鎸夐挳 -->
                                    <StackPanel Grid.Column="1" Margin="20,0,0,0">
                                        <Button Content="导入旧版或新版备份" Height="60" Margin="0,0,0,15" 
                                                Background="#FDCB6E" Foreground="#2D3436" BorderThickness="0"
                                                Click="ImportBackupButton_Click" FontSize="16" FontWeight="Bold"/>
                                        <Button Content="管理备份文件" Height="60" 
                                                Background="#636E72" Foreground="White" BorderThickness="0"
                                                Click="ManageBackupsButton_Click" FontSize="16" FontWeight="Bold"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 搴曢儴鎻愮ず -->
                                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,30,0,0">
                                        <TextBlock Text="提示：" FontSize="12" Foreground="#636E72" FontWeight="Bold"/>
                                        <TextBlock Text="建议定期导出备份，确保旧版本导出的数据也能继续导入使用。" FontSize="12" Foreground="#636E72"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Border>
</Window>


