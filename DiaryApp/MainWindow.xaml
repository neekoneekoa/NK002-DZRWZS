<Window x:Class="DiaryApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DiaryApp"
        mc:Ignorable="d"
        Title="My Diary" Height="600" Width="900"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- 颜色定义 -->
        <Color x:Key="PrimaryColor">#FF6C5CE7</Color> <!-- 软紫色 -->
        <Color x:Key="SecondaryColor">#FFA29BFE</Color>
        <Color x:Key="AccentColor">#FFFF7675</Color> <!-- 软红色 -->
        
        <!-- 样式：圆形按钮 -->
        <Style x:Key="RoundButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="bg" Fill="#FFA29BFE" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="White" TextElement.FontWeight="Bold"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Fill" Value="#FF6C5CE7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Fill" Value="#FF4834D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 样式：列表项 -->
        <Style x:Key="DiaryItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Margin="0,0,0,8" Padding="10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#336C5CE7"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A6C5CE7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 转换器 -->
        <local:PriorityToColorConverter x:Key="PriorityToColorConverter"/>
        <local:LevelToMarginConverter x:Key="LevelToMarginConverter"/>
        <local:LevelToFontWeightConverter x:Key="LevelToFontWeightConverter"/>
        <local:LevelToFontSizeConverter x:Key="LevelToFontSizeConverter"/>
        <local:BooleanToUnderlineConverter x:Key="BooleanToUnderlineConverter"/>
        
        <!-- 窗口控制按钮样式 -->
        <Style x:Key="WindowControlButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0E0E0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowBorder" CornerRadius="20" Background="#FDFDFD" Margin="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.3" Color="#6C5CE7"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 窗口控制按钮区域 -->
                <RowDefinition Height="*"/>    <!-- 主内容区域 -->
            </Grid.RowDefinitions>
            
            <!-- 顶部调整区域（用于调整窗口大小和拖动窗口） -->
            <Border Grid.Row="0" Height="5" VerticalAlignment="Top" Background="Transparent" x:Name="TopResizeBorder"/>
            
            <!-- 左侧调整区域 -->
            <Border Grid.Row="1" Width="5" HorizontalAlignment="Left" Background="Transparent" x:Name="LeftResizeBorder"/>
            
            <!-- 右侧调整区域 -->
            <Border Grid.Row="1" Width="5" HorizontalAlignment="Right" Background="Transparent" x:Name="RightResizeBorder"/>
            
            <!-- 底部调整区域 -->
            <Border Grid.Row="2" Height="5" VerticalAlignment="Bottom" Background="Transparent" x:Name="BottomResizeBorder"/>
            
            <!-- 右下角调整手柄 -->
            <ResizeGrip x:Name="ResizeGrip" Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                       Width="15" Height="15" Foreground="#6C5CE7"/>
            
            <!-- 窗口控制按钮和日期显示 -->
            <Grid Grid.Row="0" Margin="15,15,15,0">
                <TextBlock x:Name="DateLabel" Text="" FontSize="14" Foreground="#636E72" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="⚙" Style="{StaticResource WindowControlButtonStyle}" Click="SettingsButton_Click" Foreground="#0984E3" FontSize="14" ToolTip="设置"/>
                    <Button Content="🔙" Style="{StaticResource WindowControlButtonStyle}" Click="BackgroundButton_Click" Foreground="#20B2AA" FontSize="14" ToolTip="后台运行"/>
                    <Button Content="—" Style="{StaticResource WindowControlButtonStyle}" Click="MinimizeButton_Click" Foreground="#2D3436" FontSize="18" ToolTip="最小化"/>
                    <Button Content="□" Style="{StaticResource WindowControlButtonStyle}" Click="MaximizeButton_Click" Foreground="#2D3436" FontSize="14" ToolTip="全屏"/>
                    <Button Content="✕" Style="{StaticResource WindowControlButtonStyle}" Click="CloseButton_Click" Foreground="#D63031" FontSize="16" ToolTip="关闭"/>
                </StackPanel>
            </Grid>

            <!-- 主内容区域 -->
            <Grid Grid.Row="1" Margin="20,0,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 模块标题栏 -->
                    <RowDefinition Height="*"/>    <!-- 内容区域 -->
                </Grid.RowDefinitions>

                <!-- 模块标签页 -->
                <TabControl x:Name="MainTabControl" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectionChanged="MainTabControl_SelectionChanged">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Grid>
                                            <Border x:Name="border" Background="Transparent" CornerRadius="10" Padding="20,8">
                                                <ContentPresenter x:Name="contentSite"
                                                                VerticalAlignment="Center"
                                                                HorizontalAlignment="Center"
                                                                ContentSource="Header"
                                                                Margin="10,5"/>
                                            </Border>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#6C5CE7"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#A29BFE"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="False">
                                                <Setter Property="Foreground" Value="#636E72"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>

                    <!-- 日记模块 -->
                    <TabItem Header="📝 日记">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280" MinWidth="150"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*" MinWidth="200"/>
                            </Grid.ColumnDefinitions>

                            <!-- 左侧功能区 -->
                            <Border Grid.Column="0" CornerRadius="15" Background="#F0F3F8" Margin="0,0,10,0">
                                <Grid Margin="15">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- 标题 -->
                                    <TextBlock Grid.Row="0" Text="📝 日记" FontSize="18" FontWeight="Bold" 
                                               Foreground="#2D3436" Margin="0,0,0,15"/>

                                    <!-- 搜索框（带提示） -->
                                    <Border Grid.Row="1" Background="White" CornerRadius="8" Margin="0,0,0,10">
                                        <Grid>
                                            <TextBlock x:Name="DiarySearchPlaceholder" Text="� 搜索日记..." 
                                                       FontSize="12" Foreground="#B2BEC3" 
                                                       VerticalAlignment="Center" Margin="10,0" IsHitTestVisible="False"/>
                                            <TextBox x:Name="DiarySearchBox" BorderThickness="0" 
                                                     Background="Transparent" Padding="10,8"
                                                     TextChanged="DiarySearchBox_TextChanged" 
                                                     GotFocus="DiarySearchBox_GotFocus" LostFocus="DiarySearchBox_LostFocus"/>
                                        </Grid>
                                    </Border>

                                    <!-- 标签筛选 -->
                                    <Border Grid.Row="2" Background="White" CornerRadius="8" Margin="0,0,0,10">
                                        <Grid>
                                            <TextBlock x:Name="DiaryTagPlaceholder" Text="🏷️ 标签筛选..." 
                                                       FontSize="12" Foreground="#B2BEC3" 
                                                       VerticalAlignment="Center" Margin="10,0" IsHitTestVisible="False"/>
                                            <TextBox x:Name="DiaryTagFilterBox" BorderThickness="0" 
                                                     Background="Transparent" Padding="10,8"
                                                     TextChanged="DiaryTagFilterBox_TextChanged"
                                                     GotFocus="DiaryTagFilterBox_GotFocus" LostFocus="DiaryTagFilterBox_LostFocus"/>
                                        </Grid>
                                    </Border>

                                    <!-- 周期类型筛选 -->
                                    <Border Grid.Row="3" Background="White" CornerRadius="8" Margin="0,0,0,10">
                                        <Grid>
                                            <TextBlock x:Name="DiaryPeriodPlaceholder" Text="📖 周期筛选..." 
                                                       FontSize="12" Foreground="#B2BEC3" 
                                                       VerticalAlignment="Center" Margin="10,0" IsHitTestVisible="False"/>
                                            <ComboBox x:Name="DiaryPeriodFilterBox" BorderThickness="0" 
                                                      Background="Transparent" Padding="10,8"
                                                      SelectionChanged="DiaryPeriodFilterBox_SelectionChanged">
                                                <ComboBoxItem Content="全部"/>
                                                <ComboBoxItem Content="日常"/>
                                                <ComboBoxItem Content="周记"/>
                                                <ComboBoxItem Content="月计"/>
                                                <ComboBoxItem Content="季记"/>
                                                <ComboBoxItem Content="年记"/>
                                            </ComboBox>
                                        </Grid>
                                    </Border>

                                    <!-- 添加按钮 -->
                                    <Button Grid.Row="4" Content="+ 新建日记" Height="40" Background="#A29BFE" 
                                            Foreground="White" BorderThickness="0" FontWeight="Bold"
                                            Margin="0,0,0,10" Click="NewDiaryButton_Click"/>

                                    <!-- 一个月快速日期定位 -->
                                    <Border Grid.Row="5" Background="White" CornerRadius="8" Padding="12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            
                                            <!-- 月份导航 -->
                                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <Button Grid.Column="0" Content="◀" Width="25" Height="25" 
                                                        Background="Transparent" BorderThickness="1" BorderBrush="#DFE6E9"
                                                        Click="PreviousMonthButton_Click" FontSize="12"/>
                                                
                                                <TextBlock Grid.Column="1" x:Name="CurrentMonthText" Text="2024年1月" 
                                                           FontSize="14" FontWeight="Bold" Foreground="#2D3436" 
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                
                                                <Button Grid.Column="2" Content="▶" Width="25" Height="25" 
                                                        Background="Transparent" BorderThickness="1" BorderBrush="#DFE6E9"
                                                        Click="NextMonthButton_Click" FontSize="12"/>
                                            </Grid>
                                            
                                            <!-- 星期标题 -->
                                            <UniformGrid Grid.Row="1" Columns="7" Margin="0,0,0,8">
                                                <TextBlock Text="日" HorizontalAlignment="Center" FontSize="11" Foreground="#636E72" FontWeight="Bold"/>
                                                <TextBlock Text="一" HorizontalAlignment="Center" FontSize="11" Foreground="#636E72" FontWeight="Bold"/>
                                                <TextBlock Text="二" HorizontalAlignment="Center" FontSize="11" Foreground="#636E72" FontWeight="Bold"/>
                                                <TextBlock Text="三" HorizontalAlignment="Center" FontSize="11" Foreground="#636E72" FontWeight="Bold"/>
                                                <TextBlock Text="四" HorizontalAlignment="Center" FontSize="11" Foreground="#636E72" FontWeight="Bold"/>
                                                <TextBlock Text="五" HorizontalAlignment="Center" FontSize="11" Foreground="#636E72" FontWeight="Bold"/>
                                                <TextBlock Text="六" HorizontalAlignment="Center" FontSize="11" Foreground="#636E72" FontWeight="Bold"/>
                                            </UniformGrid>
                                            
                                            <!-- 日历网格 -->
                                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="250">
                                                <UniformGrid x:Name="DiaryMonthCalendarPanel" Columns="7"/>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- 可调整宽度的分隔条 -->
                            <GridSplitter Grid.Column="1" Width="6" Background="#DFE6E9" 
                                         HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                         ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                                         Cursor="SizeWE" Margin="0"/>

                            <!-- 右侧时间轴日记目录 -->
                            <Border Grid.Column="2" CornerRadius="15" Background="#FFFFFF" Padding="15">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="DiaryTimelinePanel"/>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- 任务模块 -->
                    <TabItem Header="✅ 任务">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" MinWidth="100"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="250" MinWidth="150"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*" MinWidth="200"/>
                            </Grid.ColumnDefinitions>

                            <!-- 左侧功能区 -->
                            <Border Grid.Column="0" CornerRadius="15" Background="#F0F3F8" Margin="0,0,10,0">
                                <StackPanel Margin="15" Orientation="Vertical">
                                    <!-- 功能区标题 -->
                                    <TextBlock Text="功能区" FontSize="16" FontWeight="Bold" Foreground="#2D3436" Margin="0,0,0,15"/>
                                    
                                    <!-- 添加任务按钮 -->
                                    <Button Content="+ 添加任务" Height="40" Background="#A29BFE" 
                                            Foreground="White" BorderThickness="0" FontWeight="Bold"
                                            Margin="0,0,0,10" Click="NewTaskButton_Click"/>
                                    
                                    <!-- 删除任务按钮 -->
                                    <Button Content="- 删除任务" Height="40" Background="#FF7675" 
                                            Foreground="White" BorderThickness="0" FontWeight="Bold"
                                            Margin="0,0,0,10" Click="DeleteTaskButton_Click"/>
                                    
                                    <!-- 编辑任务按钮 -->
                                    <Button Content="✏ 编辑任务" Height="40" Background="#00B894" 
                                            Foreground="White" BorderThickness="0" FontWeight="Bold"
                                            Margin="0,0,0,15" Click="EditTaskButton_Click"/>
                                    
                                    <!-- 功能区其他信息 -->
                                    <TextBlock Text="📝 任务管理" FontSize="12" Foreground="#636E72" Margin="0,10,0,0"/>
                                    <TextBlock Text="• 添加新任务" FontSize="12" Foreground="#636E72" Margin="10,5,0,0"/>
                                    <TextBlock Text="• 删除选中任务" FontSize="12" Foreground="#636E72" Margin="10,5,0,0"/>
                                    <TextBlock Text="• 编辑选中任务" FontSize="12" Foreground="#636E72" Margin="10,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- 可调整宽度的分隔条 -->
                            <GridSplitter Grid.Column="1" Width="6" Background="#DFE6E9" 
                                         HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                         ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                                         Cursor="SizeWE" Margin="0"/>

                            <!-- 中间临时任务区 -->
                            <Border Grid.Column="2" CornerRadius="15" Background="#F0F3F8" Margin="0,0,10,0">
                                <Grid Margin="15">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- 临时任务区标题 -->
                                    <TextBlock Grid.Row="0" Text="临时任务" FontSize="16" FontWeight="Bold" Foreground="#2D3436" Margin="0,0,0,10"/>

                                    <!-- 临时任务列表 -->
                                    <ListBox Grid.Row="1" x:Name="TempTaskListBox" 
                                             Background="Transparent" BorderThickness="0" 
                                             ItemContainerStyle="{StaticResource DiaryItemStyle}"
                                             SelectionChanged="TempTaskListBox_SelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="{Binding Level, Converter={StaticResource LevelToMarginConverter}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Title}" FontWeight="{Binding Level, Converter={StaticResource LevelToFontWeightConverter}}" 
                                                                   FontSize="{Binding FontSize}" 
                                                                   Foreground="{Binding TextColor}"
                                                                   Background="{Binding BackgroundColor}"
                                                                   TextDecorations="{Binding IsUnderline, Converter={StaticResource BooleanToUnderlineConverter}}"/>
                                                        <TextBlock Text="{Binding PriorityDescription}" Margin="5,0,0,0" 
                                                                   Foreground="{Binding Priority, Converter={StaticResource PriorityToColorConverter}}"
                                                                   FontSize="12" FontWeight="Bold"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding StatusDescription}" FontSize="12" Foreground="#636E72" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                            
                            <!-- 第二个可调整宽度的分隔条 -->
                            <GridSplitter Grid.Column="3" Width="6" Background="#DFE6E9" 
                                         HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                         ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                                         Cursor="SizeWE" Margin="0"/>
                            
                            <!-- 右侧项目任务区 -->
                            <Border Grid.Column="4" CornerRadius="15" Background="#FFFFFF" Padding="15">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- 项目任务区标题 -->
                                    <TextBlock Grid.Row="0" Text="项目任务" FontSize="16" FontWeight="Bold" Foreground="#2D3436" Margin="0,0,0,10"/>

                                    <!-- 项目任务列表 -->
                                    <ListBox Grid.Row="1" x:Name="ProjectTaskListBox" 
                                             Background="Transparent" BorderThickness="0" 
                                             ItemContainerStyle="{StaticResource DiaryItemStyle}"
                                             SelectionChanged="ProjectTaskListBox_SelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="{Binding Level, Converter={StaticResource LevelToMarginConverter}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Title}" FontWeight="{Binding Level, Converter={StaticResource LevelToFontWeightConverter}}" 
                                                                   FontSize="{Binding FontSize}" 
                                                                   Foreground="{Binding TextColor}"
                                                                   Background="{Binding BackgroundColor}"
                                                                   TextDecorations="{Binding IsUnderline, Converter={StaticResource BooleanToUnderlineConverter}}"/>
                                                        <TextBlock Text="{Binding PriorityDescription}" Margin="5,0,0,0" 
                                                                   Foreground="{Binding Priority, Converter={StaticResource PriorityToColorConverter}}"
                                                                   FontSize="12" FontWeight="Bold"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding StatusDescription}" FontSize="12" Foreground="#636E72" Margin="0,4,0,0"/>
                                                    <TextBlock Text="{Binding SubTasks.Count, StringFormat='子任务数：{0}'}" FontSize="12" Foreground="#636E72" Margin="0,4,0,0"/>
                                                    <ItemsControl ItemsSource="{Binding ProjectTags}" Margin="0,4,0,0">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="#E1E8ED" CornerRadius="10" Margin="0,0,5,0" Padding="6,2">
                                                                    <TextBlock Text="{Binding}" FontSize="10" Foreground="#2D3436"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- 每日时间记录模块 -->
                    <TabItem Header="⏰ 时间记录">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- 周视图控制 -->
                                <RowDefinition Height="*"/>    <!-- 时间记录区域 -->
                            </Grid.RowDefinitions>

                            <!-- 周视图控制 -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                                <Button Content="◀ 上周" Width="80" Height="35" 
                                        Background="#A29BFE" Foreground="White" BorderThickness="0"
                                        Click="PreviousWeekButton_Click" Margin="0,0,10,0"/>
                                <TextBlock x:Name="CurrentWeekText" Text="2023年第42周" 
                                           FontSize="18" FontWeight="Bold" Foreground="#2D3436" 
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Button Content="下周 ▶" Width="80" Height="35" 
                                        Background="#A29BFE" Foreground="White" BorderThickness="0"
                                        Click="NextWeekButton_Click" Margin="0,0,20,0"/>
                                <Button Content="+ 添加时间记录" Width="120" Height="35" 
                                        Background="#6C5CE7" Foreground="White" BorderThickness="0"
                                        Click="AddTimeRecordButton_Click"/>
                            </StackPanel>

                            <!-- 周视图时间表 -->
                            <Border Grid.Row="1" CornerRadius="15" Background="#FFFFFF" Padding="20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/> <!-- 时间列 -->
                                        <ColumnDefinition Width="*"/>   <!-- 周一到周日 -->
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="30"/>    <!-- 星期标题 -->
                                        <RowDefinition Height="*"/>    <!-- 时间行 -->
                                    </Grid.RowDefinitions>

                                    <!-- 星期标题 -->
                                    <TextBlock Grid.Column="1" Grid.Row="0" Text="周一" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#2D3436"/>
                                    <TextBlock Grid.Column="2" Grid.Row="0" Text="周二" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#2D3436"/>
                                    <TextBlock Grid.Column="3" Grid.Row="0" Text="周三" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#2D3436"/>
                                    <TextBlock Grid.Column="4" Grid.Row="0" Text="周四" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#2D3436"/>
                                    <TextBlock Grid.Column="5" Grid.Row="0" Text="周五" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#2D3436"/>
                                    <TextBlock Grid.Column="6" Grid.Row="0" Text="周六" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#2D3436"/>
                                    <TextBlock Grid.Column="7" Grid.Row="0" Text="周日" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#2D3436"/>

                                    <!-- 时间标签和时间块 -->
                                        <Grid x:Name="TimeGrid" Grid.Row="1" Grid.ColumnSpan="2">
                                            <Grid.RowDefinitions>
                                            <RowDefinition Height="40"/>
                                            <RowDefinition Height="40"/>
                                            <RowDefinition Height="40"/>
                                            <RowDefinition Height="40"/>
                                            <RowDefinition Height="40"/>
                                            <RowDefinition Height="40"/>
                                            <RowDefinition Height="40"/>
                                            <RowDefinition Height="40"/>
                                            <RowDefinition Height="40"/>
                                            <RowDefinition Height="40"/>
                                            <RowDefinition Height="40"/>
                                            <RowDefinition Height="40"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 时间标签 -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="08:00" FontSize="12" Foreground="#636E72" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="09:00" FontSize="12" Foreground="#636E72" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="10:00" FontSize="12" Foreground="#636E72" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="11:00" FontSize="12" Foreground="#636E72" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="12:00" FontSize="12" Foreground="#636E72" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="13:00" FontSize="12" Foreground="#636E72" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="14:00" FontSize="12" Foreground="#636E72" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Row="7" Grid.Column="0" Text="15:00" FontSize="12" Foreground="#636E72" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Row="8" Grid.Column="0" Text="16:00" FontSize="12" Foreground="#636E72" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Row="9" Grid.Column="0" Text="17:00" FontSize="12" Foreground="#636E72" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Row="10" Grid.Column="0" Text="18:00" FontSize="12" Foreground="#636E72" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Row="11" Grid.Column="0" Text="19:00" FontSize="12" Foreground="#636E72" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                        <!-- 时间块占位符 -->
                                        <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="1" Grid.ColumnSpan="7" 
                                                Background="Transparent" BorderBrush="#E8E8E8" BorderThickness="0,0,1,1" CornerRadius="0"/>
                                        <Border Grid.Row="1" Grid.Column="1" Grid.RowSpan="1" Grid.ColumnSpan="7" 
                                                Background="Transparent" BorderBrush="#E8E8E8" BorderThickness="0,0,1,1" CornerRadius="0"/>
                                        <Border Grid.Row="2" Grid.Column="1" Grid.RowSpan="1" Grid.ColumnSpan="7" 
                                                Background="Transparent" BorderBrush="#E8E8E8" BorderThickness="0,0,1,1" CornerRadius="0"/>
                                        <Border Grid.Row="3" Grid.Column="1" Grid.RowSpan="1" Grid.ColumnSpan="7" 
                                                Background="Transparent" BorderBrush="#E8E8E8" BorderThickness="0,0,1,1" CornerRadius="0"/>
                                        <Border Grid.Row="4" Grid.Column="1" Grid.RowSpan="1" Grid.ColumnSpan="7" 
                                                Background="Transparent" BorderBrush="#E8E8E8" BorderThickness="0,0,1,1" CornerRadius="0"/>
                                        <Border Grid.Row="5" Grid.Column="1" Grid.RowSpan="1" Grid.ColumnSpan="7" 
                                                Background="Transparent" BorderBrush="#E8E8E8" BorderThickness="0,0,1,1" CornerRadius="0"/>
                                        <Border Grid.Row="6" Grid.Column="1" Grid.RowSpan="1" Grid.ColumnSpan="7" 
                                                Background="Transparent" BorderBrush="#E8E8E8" BorderThickness="0,0,1,1" CornerRadius="0"/>
                                        <Border Grid.Row="7" Grid.Column="1" Grid.RowSpan="1" Grid.ColumnSpan="7" 
                                                Background="Transparent" BorderBrush="#E8E8E8" BorderThickness="0,0,1,1" CornerRadius="0"/>
                                        <Border Grid.Row="8" Grid.Column="1" Grid.RowSpan="1" Grid.ColumnSpan="7" 
                                                Background="Transparent" BorderBrush="#E8E8E8" BorderThickness="0,0,1,1" CornerRadius="0"/>
                                        <Border Grid.Row="9" Grid.Column="1" Grid.RowSpan="1" Grid.ColumnSpan="7" 
                                                Background="Transparent" BorderBrush="#E8E8E8" BorderThickness="0,0,1,1" CornerRadius="0"/>
                                        <Border Grid.Row="10" Grid.Column="1" Grid.RowSpan="1" Grid.ColumnSpan="7" 
                                                Background="Transparent" BorderBrush="#E8E8E8" BorderThickness="0,0,1,1" CornerRadius="0"/>
                                        <Border Grid.Row="11" Grid.Column="1" Grid.RowSpan="1" Grid.ColumnSpan="7" 
                                                Background="Transparent" BorderBrush="#E8E8E8" BorderThickness="0,0,1,1" CornerRadius="0"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- 累计打卡模块 -->
                    <TabItem Header="🎯 打卡统计">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 打卡记录列表 -->
                            <Border Grid.Column="0" CornerRadius="15" Background="#F0F3F8" Margin="0,0,10,0">
                                <Grid Margin="15">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- 打卡类型选择 -->
                                    <StackPanel Grid.Row="0" Margin="0,0,0,15">
                                        <TextBlock Text="打卡类型：" FontSize="14" Foreground="#636E72" Margin="0,0,0,5"/>
                                        <ComboBox x:Name="CheckInTypeCombo" SelectedIndex="0" Height="30" SelectionChanged="CheckInTypeCombo_SelectionChanged">
                                            <ComboBoxItem Content="运动"/>
                                            <ComboBoxItem Content="学习"/>
                                            <ComboBoxItem Content="阅读"/>
                                            <ComboBoxItem Content="早睡"/>
                                            <ComboBoxItem Content="早起"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- 模块标题 -->
                                    <TextBlock Grid.Row="1" Text="打卡记录" FontSize="16" FontWeight="Bold" Foreground="#2D3436" Margin="0,0,0,10"/>

                                    <!-- 打卡列表 -->
                                    <ListBox Grid.Row="2" x:Name="CheckInListBox" 
                                             Background="Transparent" BorderThickness="0" 
                                             ItemContainerStyle="{StaticResource DiaryItemStyle}"
                                             SelectionChanged="CheckInListBox_SelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Date, StringFormat={}{0:MM-dd}}" FontWeight="SemiBold" Foreground="#2D3436"/>
                                                        <TextBlock Text="{Binding Value}" Margin="5,0,0,0" FontSize="12" Foreground="#636E72"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Streak, StringFormat={}连续{0}天}" FontSize="12" Foreground="#A29BFE" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    
                                    <!-- 打卡按钮 -->
                                    <Button Grid.Row="2" Width="50" Height="50" HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                                            Style="{StaticResource RoundButtonStyle}" Click="CheckInButton_Click" Margin="0,0,5,5">
                                        <TextBlock Text="✓" FontSize="24"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- 打卡统计和编辑面板 -->
                            <Border Grid.Column="1" CornerRadius="15" Background="#FFFFFF" Padding="25">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/> <!-- 统计图表 -->
                                        <RowDefinition Height="Auto"/> <!-- 连续天数 -->
                                        <RowDefinition Height="Auto"/> <!-- 打卡记录 -->
                                        <RowDefinition Height="Auto"/> <!-- 打卡编辑 -->
                                    </Grid.RowDefinitions>

                                    <!-- 统计图表区域 -->
                                    <Border Grid.Row="0" CornerRadius="10" Background="#F8F9FA" Padding="20" Margin="0,0,0,20">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="100"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="本月打卡统计" FontSize="16" FontWeight="Bold" Foreground="#2D3436" Margin="0,0,0,10"/>
                                            <!-- 简单的柱状图占位符 -->
                                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                                <StackPanel Orientation="Vertical" Margin="2">
                                                    <Rectangle Width="20" Height="60" Fill="#A29BFE"/>
                                                    <TextBlock Text="60" FontSize="10" Foreground="#2D3436" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Vertical" Margin="2">
                                                    <Rectangle Width="20" Height="80" Fill="#6C5CE7"/>
                                                    <TextBlock Text="80" FontSize="10" Foreground="#2D3436" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Vertical" Margin="2">
                                                    <Rectangle Width="20" Height="40" Fill="#A29BFE"/>
                                                    <TextBlock Text="40" FontSize="10" Foreground="#2D3436" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Vertical" Margin="2">
                                                    <Rectangle Width="20" Height="90" Fill="#6C5CE7"/>
                                                    <TextBlock Text="90" FontSize="10" Foreground="#2D3436" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Vertical" Margin="2">
                                                    <Rectangle Width="20" Height="70" Fill="#A29BFE"/>
                                                    <TextBlock Text="70" FontSize="10" Foreground="#2D3436" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Vertical" Margin="2">
                                                    <Rectangle Width="20" Height="85" Fill="#6C5CE7"/>
                                                    <TextBlock Text="85" FontSize="10" Foreground="#2D3436" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Vertical" Margin="2">
                                                    <Rectangle Width="20" Height="50" Fill="#A29BFE"/>
                                                    <TextBlock Text="50" FontSize="10" Foreground="#2D3436" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- 连续天数统计 -->
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
                                        <Border CornerRadius="10" Background="#6C5CE7" Padding="15,10" Margin="0,0,10,0">
                                            <StackPanel>
                                                <TextBlock Text="当前连续" FontSize="12" Foreground="White" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="CurrentStreakText" Text="0" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <Border CornerRadius="10" Background="#A29BFE" Padding="15,10" Margin="0,0,10,0">
                                            <StackPanel>
                                                <TextBlock Text="最长连续" FontSize="12" Foreground="White" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="LongestStreakText" Text="0" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <Border CornerRadius="10" Background="#FD79A8" Padding="15,10">
                                            <StackPanel>
                                                <TextBlock Text="成功率" FontSize="12" Foreground="White" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="SuccessRateText" Text="0%" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- 打卡记录编辑 -->
                                    <Grid Grid.Row="3">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="打卡记录" FontSize="16" FontWeight="Bold" Foreground="#2D3436" Margin="0,0,0,10"/>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                                            <TextBox x:Name="CheckInValueTextBox" Text="完成" Width="150" Height="35" 
                                                     BorderThickness="0" Background="#F8F9FA"
                                                     Padding="10,8" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                                            <Button Content="💾 保存记录" Width="100" Height="35" 
                                                    Background="#6C5CE7" Foreground="White" BorderThickness="0"
                                                    Click="SaveCheckInButton_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- 个人信息模块 -->
                    <TabItem Header="👤 个人">
                        <Border CornerRadius="15" Background="#FFFFFF" Padding="30">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- 标题 -->
                                <TextBlock Grid.Row="0" Text="👤 个人信息" FontSize="24" FontWeight="Bold" 
                                           Foreground="#2D3436" Margin="0,0,0,30"/>

                                <!-- 说明文字 -->
                                <TextBlock Grid.Row="1" Text="管理您的个人数据信息" 
                                           FontSize="14" Foreground="#636E72" Margin="0,0,0,20"/>

                                <!-- 姓名 -->
                                <Border Grid.Row="2" Background="#F0F3F8" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="👤 姓名：" FontSize="14" FontWeight="Bold" 
                                                   Foreground="#2D3436" Margin="0,0,10,0"/>
                                        <TextBox x:Name="PersonalNameTextBox" Grid.Column="1" BorderThickness="0" 
                                                 Background="Transparent" FontSize="14" Padding="5,2"
                                                 TextChanged="PersonalNameTextBox_TextChanged" IsEnabled="False"/>
                                    </Grid>
                                </Border>

                                <!-- 电话 -->
                                <Border Grid.Row="3" Background="#F0F3F8" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="📞 电话：" FontSize="14" FontWeight="Bold" 
                                                   Foreground="#2D3436" Margin="0,0,10,0"/>
                                        <TextBox x:Name="PersonalPhoneTextBox" Grid.Column="1" BorderThickness="0" 
                                                 Background="Transparent" FontSize="14" Padding="5,2"
                                                 TextChanged="PersonalPhoneTextBox_TextChanged" IsEnabled="False"/>
                                    </Grid>
                                </Border>

                                <!-- 生日 -->
                                <Border Grid.Row="4" Background="#F0F3F8" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🎂 生日：" FontSize="14" FontWeight="Bold" 
                                                   Foreground="#2D3436" Margin="0,0,10,0"/>
                                        <DatePicker x:Name="PersonalBirthdayPicker" Grid.Column="1" BorderThickness="0" 
                                                    Background="Transparent" FontSize="14"
                                                    SelectedDateChanged="PersonalBirthdayPicker_SelectedDateChanged" IsEnabled="False"/>
                                    </Grid>
                                </Border>

                                <!-- 存款 -->
                                <Border Grid.Row="5" Background="#F0F3F8" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="💰 存款：" FontSize="14" FontWeight="Bold" 
                                                   Foreground="#2D3436" Margin="0,0,10,0"/>
                                        <TextBox x:Name="PersonalSavingsTextBox" Grid.Column="1" BorderThickness="0" 
                                                 Background="Transparent" FontSize="14" Padding="5,2"
                                                 TextChanged="PersonalSavingsTextBox_TextChanged" IsEnabled="False"/>
                                    </Grid>
                                </Border>

                                <!-- 修改/保存按钮 -->
                                <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                    <Button x:Name="EditPersonalInfoButton" Content="✏️ 修改个人信息" Height="45" 
                                            Background="#FFB74D" Foreground="White" BorderThickness="0"
                                            FontSize="16" FontWeight="Bold" Margin="0,0,10,0"
                                            Click="EditPersonalInfoButton_Click"/>
                                    <Button x:Name="SavePersonalInfoButton" Content="💾 保存个人信息" Height="45" 
                                            Background="#00B894" Foreground="White" BorderThickness="0"
                                            FontSize="16" FontWeight="Bold"
                                            Click="SavePersonalInfoButton_Click" IsEnabled="False"/>
                                </StackPanel>

                                <!-- 最后更新时间 -->
                                <TextBlock x:Name="PersonalLastUpdatedText" Grid.Row="7" 
                                           Text="最后更新：" FontSize="12" Foreground="#636E72" 
                                           HorizontalAlignment="Center" Margin="0,20,0,0"/>
                            </Grid>
                        </Border>
                    </TabItem>

                    <!-- 数据管理模块 -->
                    <TabItem Header="📦 数据管理">
                        <Border CornerRadius="15" Background="#FFFFFF" Padding="30">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 标题 -->
                                <TextBlock Grid.Row="0" Text="📦 数据管理" FontSize="24" FontWeight="Bold" Foreground="#2D3436" Margin="0,0,0,30"/>

                                <!-- 说明文字 -->
                                <TextBlock Grid.Row="1" Text="管理您的应用数据，包括保存、导出、导入和备份管理" 
                                           FontSize="14" Foreground="#636E72" Margin="0,0,0,30"/>

                                <!-- 功能按钮区域 -->
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 左侧按钮 -->
                                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                        <Button Content="💾 保存当前数据" Height="60" Margin="0,0,0,15" 
                                                Background="#00B894" Foreground="White" BorderThickness="0"
                                                Click="SaveDataButton_Click" FontSize="16" FontWeight="Bold"/>
                                        <Button Content="📤 导出备份文件" Height="60" 
                                                Background="#0984E3" Foreground="White" BorderThickness="0"
                                                Click="ExportBackupButton_Click" FontSize="16" FontWeight="Bold"/>
                                    </StackPanel>

                                    <!-- 右侧按钮 -->
                                    <StackPanel Grid.Column="1" Margin="20,0,0,0">
                                        <Button Content="📥 从备份导入" Height="60" Margin="0,0,0,15" 
                                                Background="#FDCB6E" Foreground="#2D3436" BorderThickness="0"
                                                Click="ImportBackupButton_Click" FontSize="16" FontWeight="Bold"/>
                                        <Button Content="⚙️ 管理备份文件" Height="60" 
                                                Background="#636E72" Foreground="White" BorderThickness="0"
                                                Click="ManageBackupsButton_Click" FontSize="16" FontWeight="Bold"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 底部提示 -->
                                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,30,0,0">
                                    <TextBlock Text="💡 提示：" FontSize="12" Foreground="#636E72" FontWeight="Bold"/>
                                    <TextBlock Text="建议定期导出备份以保护您的数据安全" FontSize="12" Foreground="#636E72"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Border>
</Window>
