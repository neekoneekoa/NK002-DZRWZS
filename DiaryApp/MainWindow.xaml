<Window x:Class="DiaryApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DiaryApp"
        mc:Ignorable="d"
        Title="My Diary" Height="600" Width="900"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- 颜色定义 -->
        <Color x:Key="PrimaryColor">#FF6C5CE7</Color> <!-- 软紫色 -->
        <Color x:Key="SecondaryColor">#FFA29BFE</Color>
        <Color x:Key="AccentColor">#FFFF7675</Color> <!-- 软红色 -->
        
        <!-- 样式：圆形按钮 -->
        <Style x:Key="RoundButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="bg" Fill="#FFA29BFE" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="White" TextElement.FontWeight="Bold"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Fill" Value="#FF6C5CE7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Fill" Value="#FF4834D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 样式：列表项 -->
        <Style x:Key="DiaryItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Margin="0,0,0,8" Padding="10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#336C5CE7"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A6C5CE7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="20" Background="#FDFDFD" Margin="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.3" Color="#6C5CE7"/>
        </Border.Effect>
        
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧面板 -->
            <Border Grid.Column="0" CornerRadius="20,0,0,20" Background="#F0F3F8">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- App 标题 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                        <Ellipse Width="15" Height="15" Fill="#FF7675" Margin="0,0,10,0"/>
                        <TextBlock Text="MoeDiary" FontSize="20" FontWeight="Bold" Foreground="#2D3436" FontFamily="Segoe UI"/>
                    </StackPanel>

                    <!-- 日记列表 -->
                    <ListBox Grid.Row="1" x:Name="DiaryListBox" 
                             Background="Transparent" BorderThickness="0" 
                             ItemContainerStyle="{StaticResource DiaryItemStyle}"
                             SelectionChanged="DiaryListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#2D3436"/>
                                    <TextBlock Text="{Binding DateStr}" FontSize="12" Foreground="#636E72" Margin="0,4,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    
                    <!-- 新建按钮 (悬浮在列表下方) -->
                    <Button Grid.Row="1" Width="50" Height="50" HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                            Style="{StaticResource RoundButtonStyle}" Click="NewButton_Click" Margin="0,0,10,10">
                        <TextBlock Text="+" FontSize="24"/>
                    </Button>
                </Grid>
            </Border>

            <!-- 右侧内容区域 -->
            <Grid Grid.Column="1" Margin="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 顶部控制栏 -->
                    <RowDefinition Height="Auto"/> <!-- 标题输入 -->
                    <RowDefinition Height="*"/>    <!-- 内容输入 -->
                    <RowDefinition Height="Auto"/> <!-- 底部按钮 -->
                </Grid.RowDefinitions>

                <!-- 窗口控制按钮 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="⚙" Width="30" Height="30" Click="SettingsButton_Click" Background="Transparent" BorderThickness="0" Foreground="#74B9FF" FontSize="14" FontWeight="Bold" ToolTip="设置"/>
                    <Button Content="—" Width="30" Height="30" Click="MinimizeButton_Click" Background="Transparent" BorderThickness="0" Foreground="#B2BEC3" FontSize="16"/>
                    <Button Content="✕" Width="30" Height="30" Click="CloseButton_Click" Background="Transparent" BorderThickness="0" Foreground="#FF7675" FontSize="16" FontWeight="Bold"/>
                </StackPanel>

                <!-- 标题输入 -->
                <TextBox Grid.Row="1" x:Name="TitleTextBox" 
                         Text="今天的心情..." FontSize="24" FontWeight="Bold" Foreground="#2D3436"
                         BorderThickness="0" Background="Transparent" Margin="0,10,0,20"/>

                <!-- 内容输入 -->
                <TextBox Grid.Row="2" x:Name="ContentTextBox"
                         Text="写点什么吧..." FontSize="16" Foreground="#636E72"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         BorderThickness="0" Background="Transparent" VerticalScrollBarVisibility="Auto"/>

                <!-- 底部操作栏 -->
                <Grid Grid.Row="3" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- 左侧：备份管理按钮 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Button Content="导出备份" Width="80" Height="35" Margin="0,0,10,0" 
                                Click="ExportBackupButton_Click" Background="#FFA29BFE" Foreground="White" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="导入备份" Width="80" Height="35" Margin="0,0,10,0" 
                                Click="ImportBackupButton_Click" Background="#FFA29BFE" Foreground="White" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="管理备份" Width="80" Height="35" 
                                Click="ManageBackupsButton_Click" Background="#FFA29BFE" Foreground="White" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                    
                    <!-- 右侧：保存按钮和日期 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock x:Name="DateLabel" Text="2023-10-27" VerticalAlignment="Center" Foreground="#B2BEC3" Margin="0,0,20,0"/>
                        <Button Content="保存" Width="100" Height="40" Click="SaveButton_Click"
                                Background="#6C5CE7" Foreground="White" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
