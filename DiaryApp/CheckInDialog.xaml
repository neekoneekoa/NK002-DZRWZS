<Window x:Class="DiaryApp.CheckInDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="打卡日志" Height="450" Width="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="这一刻的想法..." FontSize="16" FontWeight="Bold" Margin="0,0,0,10" Foreground="#2D3436"/>

        <TextBox x:Name="NotesTextBox" Grid.Row="1" 
                 TextWrapping="Wrap" AcceptsReturn="True" 
                 VerticalScrollBarVisibility="Auto"
                 Padding="8" FontSize="14"
                 BorderBrush="#DFE6E9" BorderThickness="1"
                 Background="#FAFAFA"/>

        <StackPanel Grid.Row="2" Margin="0,15,0,15">
            <Button x:Name="AddPhotoButton" Content="📷 添加照片" 
                    HorizontalAlignment="Left" Width="120" Height="30"
                    Background="#F0F3F8" BorderThickness="0"
                    Foreground="#2D3436"
                    Click="AddPhotoButton_Click" Cursor="Hand"/>
            
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,10,0,0" Height="110">
                <StackPanel x:Name="PhotosPanel" Orientation="Horizontal"/>
            </ScrollViewer>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Width="100" Height="35" Margin="0,0,10,0"
                    Background="#F0F3F8" Foreground="#636E72" BorderThickness="0"
                    Click="CancelButton_Click" Cursor="Hand"/>
            <Button x:Name="ConfirmButton" Content="确认打卡" Width="100" Height="35"
                    Background="#6C5CE7" Foreground="White" BorderThickness="0"
                    Click="ConfirmButton_Click" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>