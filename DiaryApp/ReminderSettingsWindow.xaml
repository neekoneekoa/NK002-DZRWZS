<Window x:Class="DiaryApp.ReminderSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DiaryApp"
        mc:Ignorable="d"
        Title="提醒设置" Height="700" Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    
    <Window.Resources>
        <!-- 颜色定义 -->
        <Color x:Key="PrimaryColor">#FF6C5CE7</Color>
        <Color x:Key="SecondaryColor">#FFA29BFE</Color>
        <Color x:Key="AccentColor">#FF7675</Color>
        <Color x:Key="SuccessColor">#00B894</Color>
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="提醒设置" FontSize="24" FontWeight="Bold" Foreground="#2D3436" Margin="0,0,0,20"/>
        
        <!-- 任务信息 -->
        <Border Grid.Row="1" Background="#F5F6FA" BorderThickness="1" BorderBrush="#E1E8ED" CornerRadius="10" Padding="15" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="任务：" FontSize="14" FontWeight="Bold" Foreground="#2D3436" Margin="0,0,0,5"/>
                <TextBlock x:Name="TaskTitleTextBlock" Text="" FontSize="16" Foreground="#2D3436"/>
            </StackPanel>
        </Border>
        
        <!-- 主要内容区域 -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            
            <!-- 提醒设置选项 -->
            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,20,0">
                <TextBlock Text="提醒规律设置" FontSize="18" FontWeight="Bold" Foreground="#2D3436" Margin="0,0,0,15"/>
                
                <!-- 规律类型选择 -->
                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="规律类型：" FontSize="14" Foreground="#636E72" Margin="0,0,0,5"/>
                    <ComboBox x:Name="ReminderTypeComboBox" Width="300" Height="35" FontSize="14">
                        <ComboBoxItem Content="每天" Tag="Daily"/>
                        <ComboBoxItem Content="连续几天" Tag="ConsecutiveDays"/>
                        <ComboBoxItem Content="连续几周" Tag="ConsecutiveWeeks"/>
                        <ComboBoxItem Content="连续几个月" Tag="ConsecutiveMonths"/>
                        <ComboBoxItem Content="间隔几天" Tag="IntervalDays"/>
                        <ComboBoxItem Content="每周特定几天" Tag="WeeklySpecific"/>
                        <ComboBoxItem Content="每月特定几天" Tag="MonthlySpecific"/>
                        <ComboBoxItem Content="记忆遗忘曲线" Tag="ForgettingCurve"/>
                    </ComboBox>
                </StackPanel>
                
                <!-- 间隔设置 -->
                <StackPanel x:Name="IntervalSettingsPanel" Margin="0,0,0,20" Visibility="Collapsed">
                    <TextBlock Text="间隔天数：" FontSize="14" Foreground="#636E72" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="IntervalDaysTextBox" Width="80" Height="35" FontSize="14" Padding="10" Text="1"/>
                        <TextBlock Text="天" FontSize="14" Foreground="#636E72" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                
                <!-- 连续设置 -->
                <StackPanel x:Name="ConsecutiveSettingsPanel" Margin="0,0,0,20" Visibility="Collapsed">
                    <TextBlock Text="持续时间：" FontSize="14" Foreground="#636E72" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="ConsecutiveCountTextBox" Width="80" Height="35" FontSize="14" Padding="10" Text="1"/>
                        <ComboBox x:Name="ConsecutiveUnitComboBox" Width="100" Height="35" FontSize="14" Margin="10,0,0,0">
                            <ComboBoxItem Content="天" Tag="Days"/>
                            <ComboBoxItem Content="周" Tag="Weeks"/>
                            <ComboBoxItem Content="月" Tag="Months"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
                
                <!-- 每周特定几天 -->
                <StackPanel x:Name="WeeklyDaysPanel" Margin="0,0,0,20" Visibility="Collapsed">
                    <TextBlock Text="每周的：" FontSize="14" Foreground="#636E72" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Content="一" Width="40" Height="30" Tag="1"/>
                        <CheckBox Content="二" Width="40" Height="30" Tag="2"/>
                        <CheckBox Content="三" Width="40" Height="30" Tag="3"/>
                        <CheckBox Content="四" Width="40" Height="30" Tag="4"/>
                        <CheckBox Content="五" Width="40" Height="30" Tag="5"/>
                        <CheckBox Content="六" Width="40" Height="30" Tag="6"/>
                        <CheckBox Content="日" Width="40" Height="30" Tag="7"/>
                    </StackPanel>
                </StackPanel>
                
                <!-- 每月特定几天 -->
                <StackPanel x:Name="MonthlyDaysPanel" Margin="0,0,0,20" Visibility="Collapsed">
                    <TextBlock Text="每月的：" FontSize="14" Foreground="#636E72" Margin="0,0,0,5"/>
                    <ItemsControl x:Name="MonthlyDaysItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding}" Width="40" Height="30" Margin="5,0,5,10" Tag="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                
                <!-- 开始时间 -->
                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="开始时间：" FontSize="14" Foreground="#636E72" Margin="0,0,0,5"/>
                    <DatePicker x:Name="StartDatePicker" Width="200" Height="35" FontSize="14"/>
                </StackPanel>
            </StackPanel>
            
            <!-- 日历显示 -->
            <StackPanel Grid.Row="0" Grid.Column="1">
                <TextBlock Text="任务出现日历" FontSize="18" FontWeight="Bold" Foreground="#2D3436" Margin="0,0,0,15"/>
                <Calendar x:Name="ReminderCalendar" Height="350" Width="280" FontSize="14" SelectionMode="MultipleRange"/>
                <TextBlock Text="预览：" FontSize="14" FontWeight="Bold" Foreground="#2D3436" Margin="0,15,0,5"/>
                <ListBox x:Name="ReminderDatesListBox" Height="150" FontSize="14"/>
            </StackPanel>
        </Grid>
        
        <!-- 按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button x:Name="SaveButton" Content="保存" Width="100" Height="40" Background="#6C5CE7" Foreground="White" BorderThickness="0" Margin="0,0,20,0" FontSize="14" Click="SaveButton_Click"/>
            <Button x:Name="DeleteButton" Content="删除" Width="100" Height="40" Background="#FF7675" Foreground="White" BorderThickness="0" Margin="0,0,20,0" FontSize="14" Click="DeleteButton_Click"/>
            <Button x:Name="CancelButton" Content="取消" Width="100" Height="40" Background="#BDC3C7" Foreground="#2D3436" BorderThickness="0" FontSize="14" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>